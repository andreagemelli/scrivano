{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window dragging, local file picking, history store, clipboard, saving results as JSON, and saving a redacted copy of a document as PDF.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "store:default",
    "clipboard-manager:allow-write-text"
  ]
}
